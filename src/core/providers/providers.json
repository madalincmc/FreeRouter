{
  "version": 5,
  "limitsNote": "Seed values from the PRD (Nov 2026). Free-tier limits change often: rate-limit headers override them at runtime and users can override them in Settings.",
  "providers": [
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyUrl": "https://openrouter.ai/settings/keys",
      "docsUrl": "https://openrouter.ai/docs",
      "termsUrl": "https://openrouter.ai/terms",
      "keyPrefix": "sk-or-",
      "mayTrainOnData": true,
      "limitScope": "account",
      "keyRotation": false,
      "limits": {
        "rpm": 20,
        "rpd": 50
      },
      "notes": "Only :free models count. 50 requests/day account-wide, or 1,000/day after a one-time purchase of 10 credits. A negative balance returns 402 even on free models. Extra keys do not add capacity.",
      "validation": {
        "url": "https://openrouter.ai/api/v1/key",
        "invalidStatuses": [
          401,
          403
        ]
      },
      "models": {
        "url": "https://openrouter.ai/api/v1/models",
        "auth": "none",
        "listPath": "data",
        "fields": {
          "id": "id",
          "name": "name",
          "contextWindow": "context_length",
          "maxOutput": "top_provider.max_completion_tokens",
          "inputModalities": "architecture.input_modalities",
          "outputModalities": "architecture.output_modalities",
          "supportedParameters": "supported_parameters"
        },
        "free": {
          "idSuffix": ":free",
          "zeroPricePaths": [
            "pricing.prompt",
            "pricing.completion"
          ]
        },
        "exclude": []
      }
    },
    {
      "id": "groq",
      "name": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyUrl": "https://console.groq.com/keys",
      "docsUrl": "https://console.groq.com/docs/rate-limits",
      "termsUrl": "https://groq.com/terms-of-use",
      "keyPrefix": "gsk_",
      "mayTrainOnData": false,
      "limitScope": "organization",
      "keyRotation": true,
      "limits": {
        "rpm": 30,
        "rpd": 1000
      },
      "notes": "Limits are per model and returned in x-ratelimit-* headers. Very fast.",
      "validation": {
        "url": "https://api.groq.com/openai/v1/models",
        "invalidStatuses": [
          401,
          403
        ]
      },
      "models": {
        "auth": "required",
        "listPath": "data",
        "fields": {
          "id": "id",
          "contextWindow": "context_window",
          "maxOutput": "max_completion_tokens",
          "active": "active"
        },
        "free": {
          "all": true
        },
        "exclude": [
          "whisper",
          "tts",
          "playai",
          "orpheus",
          "guard",
          "safeguard",
          "compound"
        ],
        "defaultTags": [
          "fast"
        ]
      },
      "request": {
        "stripParams": [
          "logprobs",
          "top_logprobs",
          "logit_bias"
        ]
      }
    },
    {
      "id": "gemini",
      "name": "Google Gemini (AI Studio)",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyUrl": "https://aistudio.google.com/apikey",
      "docsUrl": "https://ai.google.dev/gemini-api/docs/rate-limits",
      "termsUrl": "https://ai.google.dev/gemini-api/terms",
      "keyPrefix": "AIza",
      "mayTrainOnData": true,
      "limitScope": "project",
      "keyRotation": true,
      "limits": {
        "rpm": 10,
        "rpd": 250
      },
      "notes": "Limits are per model and per Google Cloud project. Flash-class models are the free workhorses. Free-tier prompts may be used for training.",
      "validation": {
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/models",
        "invalidStatuses": [
          400,
          401,
          403
        ]
      },
      "models": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models?pageSize=1000",
        "auth": "required",
        "authHeader": "x-goog-api-key",
        "listPath": "models",
        "fields": {
          "id": "name",
          "name": "displayName",
          "contextWindow": "inputTokenLimit",
          "maxOutput": "outputTokenLimit",
          "reasoningFlag": "thinking"
        },
        "idStrip": "^models/",
        "require": [
          {
            "path": "supportedGenerationMethods",
            "includes": "generateContent"
          }
        ],
        "free": {
          "all": true
        },
        "exclude": [
          "embed",
          "tts",
          "imagen",
          "veo",
          "aqa",
          "image",
          "live",
          "native-audio",
          "learnlm",
          "robotics",
          "computer-use",
          "deep-research",
          "antigravity",
          "lyria",
          "nano-banana"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "parallel_tool_calls",
          "logprobs",
          "top_logprobs"
        ]
      }
    },
    {
      "id": "cerebras",
      "name": "Cerebras",
      "baseUrl": "https://api.cerebras.ai/v1",
      "keyUrl": "https://cloud.cerebras.ai/platform",
      "docsUrl": "https://inference-docs.cerebras.ai/support/rate-limits",
      "termsUrl": "https://www.cerebras.ai/terms-of-service",
      "keyPrefix": "csk-",
      "mayTrainOnData": false,
      "limitScope": "organization",
      "keyRotation": true,
      "defaultEnabled": false,
      "limits": {
        "rpm": 30,
        "tpd": 1000000
      },
      "notes": "No free API key as of Nov 2026: new accounts need a card (a $5 trial credit). Off by default; adding a key switches it on. Very high throughput.",
      "validation": {
        "url": "https://api.cerebras.ai/v1/models",
        "invalidStatuses": [
          401,
          403
        ]
      },
      "models": {
        "auth": "required",
        "listPath": "data",
        "fields": {
          "id": "id"
        },
        "free": {
          "all": true
        },
        "exclude": [],
        "defaultTags": [
          "fast"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "parallel_tool_calls",
          "logprobs",
          "top_logprobs"
        ]
      }
    },
    {
      "id": "mistral",
      "name": "Mistral (La Plateforme)",
      "baseUrl": "https://api.mistral.ai/v1",
      "keyUrl": "https://console.mistral.ai/api-keys",
      "docsUrl": "https://mistral.ai/pricing",
      "termsUrl": "https://mistral.ai/terms",
      "mayTrainOnData": true,
      "limitScope": "organization",
      "keyRotation": true,
      "defaultEnabled": false,
      "limits": {
        "rpm": 60
      },
      "notes": "No free API key as of Nov 2026: API keys need billing on La Plateforme. Off by default; adding a key switches it on. EU hosting; Codestral is good for code.",
      "validation": {
        "url": "https://api.mistral.ai/v1/models",
        "invalidStatuses": [
          401,
          403
        ]
      },
      "models": {
        "auth": "required",
        "listPath": "data",
        "fields": {
          "id": "id",
          "name": "name",
          "contextWindow": "max_context_length",
          "toolsFlag": "capabilities.function_calling",
          "visionFlag": "capabilities.vision",
          "chatFlag": "capabilities.completion_chat"
        },
        "free": {
          "all": true
        },
        "exclude": [
          "embed",
          "moderation",
          "ocr",
          "transcribe",
          "voxtral"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "logprobs",
          "top_logprobs",
          "user"
        ]
      }
    },
    {
      "id": "nvidia",
      "name": "NVIDIA NIM (build.nvidia.com)",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "keyUrl": "https://build.nvidia.com/settings/api-keys",
      "docsUrl": "https://docs.api.nvidia.com/nim/",
      "termsUrl": "https://www.nvidia.com/en-us/about-nvidia/terms-of-service/",
      "keyPrefix": "nvapi-",
      "mayTrainOnData": true,
      "limitScope": "account",
      "keyRotation": false,
      "limits": {
        "rpm": 40
      },
      "notes": "Free developer tier for prototyping, around 40 requests/min per account (community-reported; no increases on free accounts). The model list is public; keys are checked with a 1-token chat call. Data-use terms unverified, so treated as may-train.",
      "validation": {
        "url": "https://integrate.api.nvidia.com/v1/chat/completions",
        "method": "POST",
        "body": {
          "model": "nvidia/nemotron-3.5-bolt-e4b",
          "messages": [
            {
              "role": "user",
              "content": "hi"
            }
          ],
          "max_tokens": 1
        },
        "invalidStatuses": [
          401,
          403
        ]
      },
      "models": {
        "url": "https://integrate.api.nvidia.com/v1/models",
        "auth": "none",
        "listPath": "data",
        "fields": {
          "id": "id",
          "contextWindow": "context_window",
          "toolsFlag": "supports_tools",
          "reasoningFlag": "supports_thinking"
        },
        "free": {
          "all": true
        },
        "exclude": [
          "embed",
          "retriever",
          "nemoguard",
          "safety",
          "guard",
          "gliner",
          "nvclip",
          "video-detector",
          "calibration",
          "riva-translate",
          "starcoder"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "logprobs",
          "top_logprobs"
        ]
      }
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare Workers AI",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{accountId}/ai/v1",
      "keyUrl": "https://dash.cloudflare.com/profile/api-tokens",
      "docsUrl": "https://developers.cloudflare.com/workers-ai/platform/pricing/",
      "termsUrl": "https://www.cloudflare.com/terms/",
      "credential": {
        "parts": [
          "accountId",
          "token"
        ],
        "separator": ":",
        "hint": "ACCOUNT_ID:API_TOKEN"
      },
      "mayTrainOnData": false,
      "limitScope": "account",
      "keyRotation": false,
      "limits": {
        "rpm": 300
      },
      "notes": "Free plan: 10,000 Neurons/day per account (resets 00:00 UTC), shared by all models; big models use it up much faster. Enter the key as ACCOUNT_ID:API_TOKEN, using a token with Workers AI permissions. Models that need the Workers Paid plan are skipped automatically. Don't upgrade to Workers Paid just for this: usage past the free allocation is then billed.",
      "validation": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{accountId}/ai/models/search?per_page=1",
        "invalidStatuses": [
          400,
          401,
          403,
          404
        ]
      },
      "models": {
        "url": "https://api.cloudflare.com/client/v4/accounts/{accountId}/ai/models/search?task=Text%20Generation&per_page=200",
        "auth": "required",
        "listPath": "result",
        "fields": {
          "id": "name"
        },
        "free": {
          "all": true
        },
        "exclude": [
          "lora",
          "guard"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "logprobs",
          "top_logprobs",
          "parallel_tool_calls",
          "user"
        ]
      },
      "errors": {
        "unavailable": [
          "\"code\"\\s*:\\s*5035",
          "requires a Workers Paid plan",
          "not available on the Workers Free plan",
          "\"code\"\\s*:\\s*5016",
          "submit the prompt 'agree'"
        ]
      }
    },
    {
      "id": "zai",
      "name": "Z.ai (GLM)",
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "keyUrl": "https://z.ai/manage-apikey/apikey-list",
      "docsUrl": "https://docs.z.ai/guides/overview/pricing",
      "termsUrl": "https://docs.z.ai/legal-agreement/terms-of-use",
      "mayTrainOnData": true,
      "limitScope": "account",
      "keyRotation": false,
      "limits": {
        "rpm": 20
      },
      "notes": "Only the free Flash models are used (GLM-4.7-Flash, GLM-4.5-Flash, GLM-4.6V-Flash). Z.ai doesn't publish free-tier limits and allows very few concurrent requests, so expect 429s under load. Data-use terms unverified, so treated as may-train. Operated from Singapore by Zhipu AI.",
      "validation": {
        "url": "https://api.z.ai/api/paas/v4/chat/completions",
        "method": "POST",
        "body": {
          "model": "glm-4.5-flash",
          "messages": [
            {
              "role": "user",
              "content": "hi"
            }
          ],
          "max_tokens": 1
        },
        "invalidStatuses": [
          401
        ]
      },
      "models": {
        "auth": "none",
        "listPath": "",
        "inline": [
          {
            "id": "glm-4.7-flash",
            "name": "GLM-4.7-Flash",
            "context": 200000
          },
          {
            "id": "glm-4.5-flash",
            "name": "GLM-4.5-Flash",
            "context": 128000
          },
          {
            "id": "glm-4.6v-flash",
            "name": "GLM-4.6V-Flash",
            "context": 128000,
            "vision": true
          }
        ],
        "fields": {
          "id": "id",
          "name": "name",
          "contextWindow": "context",
          "visionFlag": "vision"
        },
        "free": {
          "all": true
        },
        "exclude": []
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "logprobs",
          "top_logprobs",
          "n",
          "parallel_tool_calls",
          "presence_penalty",
          "frequency_penalty"
        ]
      }
    },
    {
      "id": "cohere",
      "name": "Cohere (trial key)",
      "baseUrl": "https://api.cohere.ai/compatibility/v1",
      "keyUrl": "https://dashboard.cohere.com/api-keys",
      "docsUrl": "https://docs.cohere.com/docs/rate-limits",
      "termsUrl": "https://cohere.com/terms-of-use",
      "mayTrainOnData": true,
      "limitScope": "account",
      "keyRotation": false,
      "limits": {
        "rpm": 20,
        "rpd": 33
      },
      "notes": "Free trial keys allow 1,000 calls a month (spread here as about 33 a day) and 20 chat requests a minute, and are not for production or commercial use. Data-use terms for trial keys unverified, so treated as may-train.",
      "validation": {
        "url": "https://api.cohere.com/v1/models?page_size=1",
        "invalidStatuses": [
          401
        ]
      },
      "models": {
        "url": "https://api.cohere.com/v1/models?endpoint=chat&page_size=1000",
        "auth": "required",
        "listPath": "models",
        "fields": {
          "id": "name",
          "contextWindow": "context_length",
          "deprecated": "is_deprecated"
        },
        "free": {
          "all": true
        },
        "exclude": [
          "translate"
        ]
      },
      "request": {
        "stripParams": [
          "logit_bias",
          "top_logprobs",
          "n",
          "parallel_tool_calls",
          "store",
          "metadata",
          "service_tier",
          "modalities",
          "prediction",
          "audio",
          "user"
        ]
      }
    }
  ]
}
